+/// Converts the API's HTML description into plain text.
+pub fn html_to_text(html: &str) -> String {
+	let html = html
+		.replace("</p>", "\n\n")
+		.replace("<br>", "\n")
+		.replace("<br/>", "\n")
+		.replace("<br />", "\n");
+	let mut out = String::with_capacity(html.len());
+	let mut in_tag = false;
+	for c in html.chars() {
+		match c {
+			'<' => in_tag = true,
+			'>' => in_tag = false,
+			_ if !in_tag => out.push(c),
+			_ => {}
+		}
+	}
+	out.replace("&amp;", "&")
+		.replace("&quot;", "\"")
+		.replace("&#39;", "'")
+		.replace("&lt;", "<")
+		.replace("&gt;", ">")
+		.replace("&nbsp;", " ")
+		.trim()
+		.into()
+}
