+/// The `series` object from `GET {API_URL}/series/{slug}`.
+///
+/// The response has been seen both as `{"series": {...}}` and as
+/// `{"data": {"series": {...}}}`, so callers locate the object first.
+#[derive(Deserialize)]
+pub struct ApiSeries {
+	pub title: Option<String>,
+	pub cover: Option<String>,
+	pub description: Option<String>,
+	pub status: Option<String>,
+	#[serde(rename = "type")]
+	pub kind: Option<String>,
+	pub public_url: Option<String>,
+	pub author: Option<String>,
+	pub artist: Option<String>,
+	pub genres: Option<Vec<ApiGenre>>,
+}
+
+#[derive(Deserialize)]
+pub struct ApiGenre {
+	pub name: String,
+}
+
+/// One entry from `GET {API_URL}/series/{slug}/chapters`.
+#[derive(Deserialize)]
+pub struct ApiChapter {
+	pub number: f64,
+	pub is_premium: Option<bool>,
+	pub published_at: Option<String>,
+}
